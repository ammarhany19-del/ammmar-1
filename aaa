<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>خطة عمل تأسيس المتجر الإلكتروني</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Tajawal', sans-serif;
            background-color: #faf9f6;
            color: #2d3748;
        }
        .chart-container {
            position: relative;
            width: 100%;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            height: 300px;
            max-height: 400px;
        }
        .step-active {
            border-right: 4px solid #1e3a8a;
            background-color: #f1f5f9;
        }
        @media (min-width: 768px) {
            .chart-container { height: 350px; }
        }
    </style>
</head>
<body class="antialiased">

    <!-- Chosen Palette: Warm Sands & Professional Navy -->
    <!-- Application Structure Plan: 
         1. قسم الترحيب: رسالة موجهة للعميل لكسر الجليد.
         2. لوحة الإحصائيات (Stats Dashboard): ملخص سريع للمشروع (المدة الإجمالية والمراحل).
         3. المستكشف التفاعلي (Interactive Explorer): تقسيم مراحل العمل الخمس إلى تبويبات تفاعلية لتجنب الإطالة البصرية وتسهيل القراءة.
         4. تحليل توزيع الوقت: استخدام Chart.js لتوضيح أين يذهب الجهد الأكبر (مرحلة التصميم والبرمجة).
         5. قسم المتطلبات: تذكير العميل بدوره لضمان سرعة الإنجاز.
    -->

    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-2 space-x-reverse">
                <div class="w-10 h-10 bg-blue-900 rounded-lg flex items-center justify-center text-white font-bold text-xl">S</div>
                <span class="font-bold text-xl text-blue-900">خطة عمل المتجر</span>
            </div>
            <div class="text-sm text-gray-500 font-medium">عرض فني وتقني</div>
        </div>
    </nav>

    <main class="max-w-6xl mx-auto px-4 py-12">
        
        <header class="mb-12 text-center">
            <h1 class="text-4xl font-extrabold text-blue-900 mb-4">دورة عمل تأسيس متجركم الإلكتروني</h1>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
                مرحباً بك. هذا العرض يوضح المسار الزمني "السايكل" المتوقع لبناء متجرك من الصفر وحتى الإطلاق النهائي، موزعة على مراحل احترافية تضمن الجودة والسرعة.
            </p>
        </header>

        <!-- Stats Dashboard -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center">
                <span class="text-gray-500 mb-2 font-medium">إجمالي المراحل</span>
                <span class="text-4xl font-bold text-blue-900">5 مراحل</span>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border-b-4 border-blue-900 flex flex-col items-center text-center">
                <span class="text-gray-500 mb-2 font-medium">المدة الإجمالية التقريبية</span>
                <span class="text-3xl font-bold text-blue-900">6 - 11 يوم عمل</span>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center">
                <span class="text-gray-500 mb-2 font-medium">جاهزية التنفيذ</span>
                <span class="text-4xl font-bold text-green-600">100%</span>
            </div>
        </section>

        <!-- Interactive Cycle Section -->
        <section class="mb-20">
            <div class="mb-10">
                <h2 class="text-2xl font-bold text-blue-900 mb-2">استكشف مراحل الرحلة</h2>
                <p class="text-gray-600">يرجى الضغط على المرحلة لعرض المهام التفصيلية والمدة الزمنية الخاصة بها.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
                <!-- Tabs Sidebar -->
                <div class="lg:col-span-4 space-y-4">
                    <button onclick="updateStep(1)" id="btn-1" class="w-full text-right p-5 rounded-2xl transition-all duration-300 step-active shadow-sm border border-gray-50">
                        <span class="block text-xs font-bold text-blue-700 mb-1">المرحلة 01</span>
                        <span class="block text-lg font-bold">التهيئة والتوثيق (SEO)</span>
                    </button>
                    <button onclick="updateStep(2)" id="btn-2" class="w-full text-right p-5 rounded-2xl transition-all duration-300 bg-white hover:bg-gray-50 shadow-sm border border-gray-100">
                        <span class="block text-xs font-bold text-gray-400 mb-1">المرحلة 02</span>
                        <span class="block text-lg font-bold">إدخال المحتوى والمنتجات</span>
                    </button>
                    <button onclick="updateStep(3)" id="btn-3" class="w-full text-right p-5 rounded-2xl transition-all duration-300 bg-white hover:bg-gray-50 shadow-sm border border-gray-100">
                        <span class="block text-xs font-bold text-gray-400 mb-1">المرحلة 03</span>
                        <span class="block text-lg font-bold">التصميم الإبداعي (UI)</span>
                    </button>
                    <button onclick="updateStep(4)" id="btn-4" class="w-full text-right p-5 rounded-2xl transition-all duration-300 bg-white hover:bg-gray-50 shadow-sm border border-gray-100">
                        <span class="block text-xs font-bold text-gray-400 mb-1">المرحلة 04</span>
                        <span class="block text-lg font-bold">التطبيق البرمجي</span>
                    </button>
                    <button onclick="updateStep(5)" id="btn-5" class="w-full text-right p-5 rounded-2xl transition-all duration-300 bg-white hover:bg-gray-50 shadow-sm border border-gray-100">
                        <span class="block text-xs font-bold text-gray-400 mb-1">المرحلة 05</span>
                        <span class="block text-lg font-bold">التحسينات والإطلاق</span>
                    </button>
                </div>

                <!-- Step Detail Card -->
                <div class="lg:col-span-8 bg-white rounded-3xl p-10 shadow-xl border border-blue-50 relative min-h-[450px]">
                    <div id="step-display-content" class="transition-opacity duration-300">
                        <!-- Dynamic Content -->
                    </div>
                </div>
            </div>
        </section>

        <!-- Chart Section -->
        <section class="mb-20 bg-blue-900 rounded-[3rem] p-10 text-white overflow-hidden relative">
            <div class="flex flex-col md:flex-row items-center gap-12 relative z-10">
                <div class="md:w-1/2">
                    <h3 class="text-3xl font-bold mb-6">توزيع الجهد والزمن</h3>
                    <p class="text-blue-100 leading-relaxed mb-6">
                        يوضح هذا التمثيل البياني كيف يتم تقسيم وقت المشروع. نركز بشكل مكثف على مرحلة "التصميم" و"التهيئة" لضمان أساس قوي وقبول سريع من محركات البحث والعملاء.
                    </p>
                    <div class="space-y-4">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center text-xl">⏳</div>
                            <div>
                                <p class="font-bold">مراحل سريعة</p>
                                <p class="text-sm text-blue-200">التهيئة والمحتوى والإطلاق.</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center text-xl">💎</div>
                            <div>
                                <p class="font-bold">مراحل تركيز</p>
                                <p class="text-sm text-blue-200">التصميم والبرمجة لضمان تميز علامتكم.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="md:w-1/2 w-full">
                    <div class="chart-container">
                        <canvas id="cycleChart"></canvas>
                    </div>
                </div>
            </div>
        </section>

        <!-- Requirements -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
            <div class="p-8 bg-orange-50 rounded-3xl border border-orange-100">
                <h4 class="text-xl font-bold text-orange-900 mb-4 flex items-center gap-2">
                    <span>📝</span> متطلبات البدء
                </h4>
                <ul class="space-y-3 text-orange-800">
                    <li class="flex gap-2"><span>•</span> الشعار وأكواد الألوان.</li>
                    <li class="flex gap-2"><span>•</span> صور وبيانات المنتجات كاملة.</li>
                    <li class="flex gap-2"><span>•</span> وثائق توثيق المتجر (معروف/سجل تجاري).</li>
                </ul>
            </div>
            <div class="p-8 bg-green-50 rounded-3xl border border-green-100">
                <h4 class="text-xl font-bold text-green-900 mb-4 flex items-center gap-2">
                    <span>✅</span> ماذا ستحصل في النهاية؟
                </h4>
                <ul class="space-y-3 text-green-800">
                    <li class="flex gap-2"><span>•</span> متجر جاهز للبيع مباشرة.</li>
                    <li class="flex gap-2"><span>•</span> واجهة حصرية متوافقة مع الجوال.</li>
                    <li class="flex gap-2"><span>•</span> ربط كامل مع أدوات جوجل للتحليل والـ SEO.</li>
                </ul>
            </div>
        </section>

        <footer class="text-center py-10 border-t border-gray-200">
            <p class="text-blue-900 font-bold text-lg">نتطلع لبناء قصة نجاحكم القادمة!</p>
            <p class="text-gray-500 text-sm mt-2 font-medium italic">تم إعداد هذا العرض خصيصاً لمشروع تأسيس المتجر الإلكتروني</p>
        </footer>

    </main>

    <script>
        const steps = {
            1: {
                title: "التهيئة المبدئية وتوثيق المتجر",
                time: "يوم إلى يومين",
                description: "هذه هي مرحلة التأسيس التي نضمن فيها ظهور المتجر بشكل رسمي واحترافي أمام الجهات والعملاء.",
                tasks: [
                    "التهيئة المبدئية لأعمال الـ SEO لظهور المتجر في البحث.",
                    "توثيق المتجر بالمنصات المعتمدة.",
                    "إضافة جميع البيانات المبدئية (العناوين، أرقام التواصل، السياسات).",
                    "ضبط إعدادات الشحن والدفع الأولية."
                ],
                icon: "🏛️"
            },
            2: {
                title: "رفع المنتجات وتنسيق المحتوى",
                time: "يوم إلى يومين",
                description: "تحويل قائمة منتجاتكم إلى معرض رقمي جذاب يدفع الزائر للشراء.",
                tasks: [
                    "رفع جميع المنتجات وصورها بجودة عالية.",
                    "كتابة المواصفات والخيارات (ألوان، أحجام، أنواع).",
                    "تنسيق المحتوى التعريفي للأقسام.",
                    "ضبط تفاصيل المخزون والأسعار لكل منتج."
                ],
                icon: "📦"
            },
            3: {
                title: "تصميم واجهة الموقع (UI/UX)",
                time: "يومين إلى ثلاثة أيام",
                description: "المرحلة الإبداعية التي تميز متجركم عن المنافسين وتعكس هويتكم التجارية الفريدة.",
                tasks: [
                    "دراسة هوية المتجر واختيار الخطوط والألوان المناسبة.",
                    "تصميم الواجهة الرئيسية وصفحات الأقسام.",
                    "توزيع العناصر لضمان أفضل تجربة تصفح للعميل.",
                    "تقديم النموذج المبدئي للاعتماد."
                ],
                icon: "🎨"
            },
            4: {
                title: "التطبيق البرمجي للواجهة",
                time: "يوم إلى يومين",
                description: "تحويل التصميم الفني إلى واقع ملموس يتفاعل معه العميل بسرعة وسلاسة.",
                tasks: [
                    "تطبيق التصميم المعتمد برمجياً على منصة المتجر.",
                    "تأكيد توافق المتجر مع كافة أحجام الجوالات والشاشات.",
                    "اختبار سلاسة رحلة العميل من الإضافة للسلة حتى الدفع.",
                    "تفعيل الروابط والأزرار التفاعلية."
                ],
                icon: "💻"
            },
            5: {
                title: "تحسينات الـ SEO واللمسات الأخيرة",
                time: "يوم إلى يومين",
                description: "مرحلة التدقيق النهائي لضمان انطلاقة قوية وخالية من الأخطاء التقنية.",
                tasks: [
                    "تكملة أعمال الـ SEO للأقسام والصفحات الداخلية.",
                    "ربط الدومين (رابط المتجر الخاص).",
                    "ربط الأدوات التحليلية (Google Analytics) لمتابعة الزوار.",
                    "الفحص النهائي لسرعة المتجر وتفعيله للإطلاق."
                ],
                icon: "🚀"
            }
        };

        function updateStep(id) {
            // UI Toggle
            for (let i = 1; i <= 5; i++) {
                const btn = document.getElementById(`btn-${i}`);
                if (i === id) {
                    btn.classList.add('step-active', 'text-blue-900');
                    btn.classList.remove('bg-white', 'text-gray-400');
                } else {
                    btn.classList.remove('step-active', 'text-blue-900');
                    btn.classList.add('bg-white', 'text-gray-400');
                }
            }

            // Content Update
            const container = document.getElementById('step-display-content');
            const data = steps[id];
            
            container.style.opacity = '0';
            setTimeout(() => {
                container.innerHTML = `
                    <div class="flex items-center gap-5 mb-8">
                        <div class="text-6xl">${data.icon}</div>
                        <div>
                            <h3 class="text-2xl font-bold text-blue-900">${data.title}</h3>
                            <span class="inline-block bg-blue-100 text-blue-800 text-sm font-bold px-4 py-1 rounded-full mt-2">المدة: ${data.time}</span>
                        </div>
                    </div>
                    <p class="text-gray-700 text-lg leading-relaxed mb-8">${data.description}</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        ${data.tasks.map(t => `
                            <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl border border-gray-100">
                                <span class="text-blue-600 mt-1">✓</span>
                                <span class="text-gray-700 font-medium">${t}</span>
                            </div>
                        `).join('')}
                    </div>
                `;
                container.style.opacity = '1';
            }, 200);
        }

        function initChart() {
            const ctx = document.getElementById('cycleChart').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['التهيئة', 'المحتوى', 'التصميم', 'البرمجة', 'الإطلاق'],
                    datasets: [{
                        data: [15, 15, 35, 20, 15],
                        backgroundColor: ['#60a5fa', '#34d399', '#fbbf24', '#818cf8', '#f472b6'],
                        hoverOffset: 10,
                        borderWidth: 0
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: '#fff', font: { family: 'Tajawal', size: 12 } }
                        }
                    }
                }
            });
        }

        window.onload = () => {
            updateStep(1);
            initChart();
        };
    </script>

    <!-- Visualization & Content Choices: 
         - تم استخدام Dashboard في البداية لتوضيح "إجمالي الأيام" وهي المعلومة الأهم للعميل.
         - تم تقسيم الـ 5 مراحل إلى تبويبات تفاعلية (Tabs) لمنع حدوث ملل من القراءة الطويلة.
         - تم استخدام Doughnut Chart لتوضيح "ثقل" كل مرحلة، حيث يرى العميل أن التصميم يأخذ الحيز الأكبر لضمان الجودة.
         - تأكيد: لا يوجد استخدام لرسومات SVG أو Mermaid.
    -->
    <!-- CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. -->
</body>
</html>
